# Invoice AI — local placeholders only. Copy to .env and adjust.
# Never commit real secrets. No paid APIs required.

# ---------------------------------------------------------------------------
# Demo vs production
# APP_ENV=development|demo|test  → demo-login allowed; weak SECRET_KEY ok
# APP_ENV=production|prod        → demo-login disabled; strong SECRET_KEY
#                                  required (>=32 chars, not a sample value);
#                                  DEBUG must be false
# ---------------------------------------------------------------------------

# App
APP_NAME=Invoice AI
APP_ENV=development
DEBUG=true
APP_VERSION=0.6.0-m6

# API
API_HOST=0.0.0.0
API_PORT=8004
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3004

# Database (matches docker-compose.yml — host port 5436)
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_USER=invoiceai
POSTGRES_PASSWORD=invoiceai_dev_password
POSTGRES_DB=invoice_ai
DATABASE_URL=postgresql+psycopg://invoiceai:invoiceai_dev_password@localhost:5436/invoice_ai

# Auth (demo / prototype only — not production)
# Seed creates multiple users; password for all demo accounts is "demo"
DEMO_USER_EMAIL=demo@invoiceai.local
DEMO_USER_PASSWORD=demo
SECRET_KEY=change-me-local-dev-only-32b-min
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=8

# Rate limits (in-memory, per process)
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
AI_RATE_LIMIT=60
AI_RATE_WINDOW_SECONDS=60

# Business Insights connector (optional shared token alternative to org JWT)
# When set, callers may use Authorization: Bearer <token> + X-Organization-Id
INSIGHTS_CONNECTOR_TOKEN=

# AI provider: demo (default, no network) | ollama (optional local open model)
# Demos and tests do NOT require Ollama. No paid LLM/OCR APIs.
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Web (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8004
NEXT_PUBLIC_APP_NAME=Invoice AI

# Mobile (Flutter — optional)
API_BASE_URL=http://localhost:8004
