# Invoice AI — local placeholders only. Copy to .env and adjust.
# Never commit real secrets.

# App
APP_NAME=Invoice AI
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8004
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3004

# Database (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=invoiceai
POSTGRES_PASSWORD=invoiceai_dev_password
POSTGRES_DB=invoice_ai
DATABASE_URL=postgresql+psycopg://invoiceai:invoiceai_dev_password@localhost:5434/invoice_ai

# Auth (demo placeholder — not production)
DEMO_USER_EMAIL=demo@invoiceai.local
DEMO_USER_PASSWORD=demo
SECRET_KEY=change-me-local-dev-only
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider: demo | ollama
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Web (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8004
NEXT_PUBLIC_APP_NAME=Invoice AI

# Mobile
API_BASE_URL=http://localhost:8004
